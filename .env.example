# .env.example — memex 远程部署样例
# 复制为 .env 后按实际部署填写；勿提交真实 token

# 静态 Bearer Token（E16，必填）。生成：openssl rand -hex 32
# 换 token = 轮换全部在途 bundle 票据（HMAC 密钥即 token），这是有意的
MEMEX_TOKEN=

# 对外基址（必填）：票据按它拼绝对 URL 给远程 agent；反代换域名只改这一处
MEMEX_PUBLIC_BASE_URL=https://memex.example.com

# Origin 白名单（逗号分隔，防 DNS rebinding）。留空 = 与 MEMEX_PUBLIC_BASE_URL 同源。
# 无 Origin 头（curl / git / 非浏览器 MCP 客户端）恒放行；有 Origin 必须在名单内
MEMEX_ALLOWED_ORIGINS=https://memex.example.com

# —— 以下都有内置默认值，按需覆盖 ——
# 嵌入模型（镜像已烘焙，改了要 docker compose exec memex memex reindex --embedder <新模型>）
MEMEX_EMBEDDER=paraphrase-multilingual-MiniLM-L12-v2
# 三闸：不加限制等于把 clone / embed 闸对全网开放
MEMEX_HTTP_QPS_PER_TOKEN=10
MEMEX_CLONE_CONCURRENCY=3
MEMEX_EMBED_CONCURRENCY=1
# bundle 票据 TTL（秒）与待下发目录总量上限（字节，超了按 LRU 删最老）
MEMEX_BUNDLE_TTL_SECONDS=3600
MEMEX_MAX_BUNDLE_BYTES=268435456
